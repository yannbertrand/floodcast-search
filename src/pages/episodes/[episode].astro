---
import '@picocss/pico';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import _netlifyLogo from '@assets/netlify.svg';
import EpisodeLines from '@components/EpisodeLines.astro';
import EpisodeSearch from '@components/EpisodeSearch.astro';

export async function getStaticPaths() {
	const episodes = await getCollection('episodes');
	return episodes.map((episode) => {
		return {
			params: { episode: episode.id },
			props: { episode },
		};
	});
}

const { episode } = Astro.props;

const hasGuests = episode.data.guests.length > 0;
---
<html lang="fr">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width" />
    <title>FloodCast Search > {episode.data.metadata.code} - {episode.data.metadata.title}</title>
  </head>
  <body>
    <main class="container">
        <hgroup class="titles">
            <a href="/"><h1>FloodCast > Il s'agissait du…</h1></a>
            <p class="title">{episode.data.metadata.title}<span class="code">{episode.data.metadata.code}</p>
        </hgroup>
        <div class="description" set:html={episode.data.metadata.description} />
        <p>Sortie le {episode.data.metadata.uploadDate}</p>
        {hasGuests &&
            <h2>Invités</h2>
            <ul class="guests">
                {episode.data.guests.map((guest: string) => (
                    <li>{guest}</li>
                ))}
            </ul>
        }
        <hr>
        <h2>Rechercher dans l'épisode</h2>
        <EpisodeSearch episode={episode.data} />
        <hr>
        <h2>Transcription de l'épisode</h2>
        <EpisodeLines episode={episode.data} />

        <a href="https://www.netlify.com">
            <Image src={_netlifyLogo} alt="Deployé par Netlify" width="114" height="51">
        </a>
    </main>
  </body>
</html>

<style>
.titles .title {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    color: var(--pico-primary);
    font-size: 1.6rem;
    --pico-font-weight: 600;
    --pico-font-family: var(--pico-font-family-sans-serif);
    text-transform: uppercase;
}
.titles .title .code {
    float: right;
    color: var(--pico-color);
    font-size: 1.0rem;
}
.description {
    --pico-typography-spacing-vertical: calc(var(--pico-typography-spacing-vertical) / 2)
}
.description br {
    line-height: 0!important;
}
.guests {
    display: flex;
    flex-wrap: wrap;
    gap: 0 calc(2 * var(--pico-spacing));
}
</style>
