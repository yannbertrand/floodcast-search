---
import { Image } from 'astro:assets';
import _netlifyLogo from '@assets/netlify.svg';
import SearchBox from '@components/SearchBox.astro';
import type { Episode } from '../types.ts';

interface Props {
	episode: Episode;
}

const { episode } = Astro.props;
---
<div id="searchbox" data-episode-id={episode.id}>
    <SearchBox />
</div>

<div id="hits" class="hits"></div>

<div class="powered-by">
    <div id="algolia"></div>
</div>

<script>
import { indexName, searchClient } from '@services/algolia.service.ts';
import type { InstantSearchStatus } from 'instantsearch.js/es/types/instantsearch.d.ts';
import connectSearchBox, { type SearchBoxRenderState } from 'instantsearch.js/es/connectors/search-box/connectSearchBox';
import { getContainerNode } from 'instantsearch.js/es/lib/utils/getContainerNode';
import { configure, infiniteHits, poweredBy } from 'instantsearch.js/es/widgets';
import type { SearchBoxWidgetParams } from 'instantsearch.js/es/widgets/search-box/search-box';
import instantsearch, { type UiState } from 'instantsearch.js';
import { history } from 'instantsearch.js/es/lib/routers';

const episodeId = document.getElementById('searchbox')?.dataset.episodeId

function renderSearchBox  (
    renderOptions: SearchBoxRenderState & { instantSearchInstance: { status: InstantSearchStatus }} & { widgetParams: SearchBoxWidgetParams },
    isFirstRender: boolean
) {
    const { query, refine, instantSearchInstance, widgetParams } = renderOptions;
    const container = getContainerNode(widgetParams.container);
    const isSearchStalled = instantSearchInstance.status === 'stalled';
    const input = container.querySelector('input') as HTMLInputElement;

    if (isFirstRender) {
        input.addEventListener('input', (event) => {
            refine((event.currentTarget as HTMLInputElement).value);
        });
    }

    input.value = query;
    if (isSearchStalled) {
        input.classList.add('loading');
    } else {
        input.classList.remove('loading');
    }
};

const customSearchBox = connectSearchBox(renderSearchBox);

type EpisodeSearchQueryParams = {
	recherche?: string;
};

type GenericObject = {
	// biome-ignore lint/suspicious/noExplicitAny: generic
	[key: string]: any;
};

const algolia = instantsearch({
	indexName,
	searchClient,
	routing: {
        router: history({
			createURL({ qsModule, routeState, location }) {
				const baseUrl = location.origin;
				const pathname = location.pathname;
				const hash = location.hash;
				const queryParameters: EpisodeSearchQueryParams = {};
				if (routeState.query) {
					queryParameters.recherche = routeState.query as string;
				}

				const queryString = qsModule.stringify(queryParameters, {
					addQueryPrefix: true,
					arrayFormat: 'repeat',
				});

				return `${baseUrl}${pathname}${queryString}${hash}`;
			},

			parseURL({ qsModule, location }): GenericObject {
				const { recherche = '' } = qsModule.parse(
					location.search.slice(1),
				);

				return {
					query: recherche as string,
				};
			},
		}),

		stateMapping: {
			stateToRoute(uiState): GenericObject {
				const indexUiState = uiState[indexName] || {};

				return {
					query: indexUiState.query,
				};
			},

			routeToState(routeState): UiState {
				return {
					[indexName]: {
						query: routeState.query,
					},
				};
			},
		},
    }
})

algolia.addWidgets([
    customSearchBox({
        container: '#searchbox'
    }),

    poweredBy({
        container: '#algolia',
    }),

    configure({
        distinct: false,
        filters: `episode.id: "${episodeId}"`,
        hitsPerPage: 3,
    }),

    infiniteHits({
        container: '#hits',
        cssClasses: {
            list: 'list-episodes'
        },
        templates: {
            showMoreText: () => 'Voir plus',
            showPreviousText: () => 'Voir moins',
            empty: () => '<h2>Pas de résultats</h2>',
            item(hit, { html, components }) {
                return html`
                    <p><a href="#${hit.id}">${components.Highlight({ hit, attribute: 'content' })}</a></p>
                `;
            },
        },
    }),
]);

algolia.start();
</script>

<style is:global>
.content {
    display: flex;
    flex-wrap: wrap;
    gap: var(--pico-spacing);
    margin-bottom: var(--pico-spacing);
}
.facets {
    flex-shrink: 0;
    flex-basis: 210px;
}
.list-seasons {
    padding: 0;
}
.list-seasons li::marker {
    content: '';
}
.powered-by {
    text-align: right;
}
.powered-by * {
    max-width: 114px;
    display: inline;
}
.hits {
    margin-bottom: var(--pico-spacing);
    flex: 1;
}
.list-episodes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--pico-spacing);
    list-style: none;
    padding: 0;

    & .title {
        --pico-font-size: 1rem;
        --pico-line-height: 1.25;
        --pico-typography-spacing-top: 1.5rem;
        color: var(--pico-muted-color);

        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: calc(var(--pico-spacing) / 2);
    }
}
</style>
